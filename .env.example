# ═══════════════════════════════════════════════════
# AlphaDesk — Environment Variables
# Copy to .env and fill in your keys
# ═══════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────
# These must be set or the system won't start.

# OpenRouter (powers all LLM analysis)
# Get key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# MySQL persistence
ALPHADESK_DB_HOST=127.0.0.1
ALPHADESK_DB_PORT=3306
ALPHADESK_DB_NAME=alphadesk
ALPHADESK_DB_USER=alphadesk
ALPHADESK_DB_PASSWORD=alphadesk
ALPHADESK_DB_POOL_SIZE=5

# ── NEWS & MARKET DATA ───────────────────────────
# At least one news source recommended for full coverage.

# Finnhub (company news per ticker)
# Free tier: 60 calls/min
# Get key: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key

# NewsAPI (market headlines + business news)
# Free tier: 100 calls/day
# Get key: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key

# ── ADVISOR LAYER (new) ──────────────────────────

# FRED (Federal Reserve Economic Data — macro indicators)
# Powers: interest rates, yield curve, inflation, unemployment
# Free: unlimited calls
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key

# Financial Modeling Prep (earnings call transcripts + guidance)
# Powers: earnings analysis, management quotes, cross-company mentions
# Free tier: 250 calls/day (enough for daily runs)
# Get key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_key

# Kalshi (prediction market data — crowd sentiment)
# Powers: Fed rate cut odds, recession probability, policy outcomes
# Optional — Polymarket (the other source) needs no key
# Get key: https://kalshi.com/sign-up (API access in account settings)
KALSHI_API_KEY=your_kalshi_key

# ── OPTIONAL ──────────────────────────────────────

# Reddit API (for Street Ear — Reddit blocks most anonymous traffic, so without
# these the sentiment sensor returns nothing).
# Create an app at https://www.reddit.com/prefs/apps (type "script"):
#   • the string under the app name is the client ID
#   • "secret" is the client secret
# client_id + secret alone = app-only read access. Add username/password for a
# script app's password grant (more reliable). User-agent is recommended.
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USERNAME=your_reddit_username
# REDDIT_PASSWORD=your_reddit_password
# REDDIT_USER_AGENT=AlphaDesk/0.1 by u/your_username

# YouTube Data API v3 key (for YouTube Ear agent)
# Free tier: 10,000 quota units/day (sufficient for curated channel list)
# Get key: https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=your_youtube_api_key

# LunarCrush (social sentiment for stocks + crypto)
# Powers: galaxy scores, social volume, trending stocks/topics
# Used by: holdings_monitor (social indicator), moonshot_manager (candidate sourcing)
# Free tier available
# Get key: https://lunarcrush.com/developers/api
# LUNARCRUSH_API_KEY=your_lunarcrush_api_key

# Daily API spend cap in USD (default: $20)
# When exceeded, LLM synthesis is skipped and raw data is delivered instead.
DAILY_COST_CAP=20.00

# ── MODEL COUNCIL (optional, off by default) ───────────
COUNCIL_ENABLED=false
COUNCIL_MODEL_TIMEOUT_S=60
COUNCIL_STREAM_TIMEOUT_S=60
COUNCIL_COST_CAP_USD=2.00
COUNCIL_BRIEF_MAX_TOKENS=3500
OPENROUTER_ANALYSIS_MODELS=z-ai/glm-5.2,moonshotai/kimi-k2.6,deepseek/deepseek-v4-pro

# OpenRouter Fusion (Phase F local cockpit)
# If set, the FastAPI council route uses model=openrouter/fusion and can pass
# the selected UI model chips as Fusion analysis_models.
OPENROUTER_FUSION_MODEL=openrouter/fusion
OPENROUTER_FUSION_JUDGE=anthropic/claude-opus-4.8
OPENROUTER_SITE_URL=http://localhost:5173
